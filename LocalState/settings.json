        },
        {
            "id": null,
            "keys": "ctrl+shift+d"
        },
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+shift+c"
        },
        {
            "id": null,
            "keys": "shift+insert"
        },
        {
            "id": null,
            "keys": "ctrl+insert"
        },
        {
